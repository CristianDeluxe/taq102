From 7caf2c0110ef31efe83f2730722560cf9b86cff6 Mon Sep 17 00:00:00 2001
From: Cristian Deluxe <info@busirocket.com>
Date: Wed, 9 Sep 2026 03:53:37 +0200
Subject: [PATCH 05/17] phy: rockchip: inno-dsidphy: power up the common analog
 block in LVDS mode

The LVDS path programs the PLL dividers into REGISTER_PART_ANALOG 0x03/0x04
and then powers on only the LVDS-side PLL and bandgap. It never powers on
the
common analog LDO and PLL (ANALOG 0x01 REG_LDOPD/REG_PLLPD), never pulses
the
analog sync reset after loading the dividers, and never enables the analog
lanes behind the LVDS drivers (ANALOG 0x00 LANE_EN). The MIPI path does all
three.

inno_dsidphy_power_off() does power the common LDO and PLL *down*, so the
omission is also asymmetric: after one power_off/power_on cycle the block
stays down.

The evidence for this on the vendor 4.4 driver is weaker than the asymmetry
above, and should not be overstated: kernel/patches/0002 makes the
equivalent
change on a Rockchip RK3126C with a 1024x600 LVDS panel, and that panel is
lit and correct both with it and without it -- the analog block reads its
reset defaults either way. It is kept there because it matches the state
the
vendor bootloader leaves, and it is carried here for the same reason plus
the
power_off asymmetry, which the vendor driver does not have.

Signed-off-by: Cristian Deluxe <info@busirocket.com>
---
 drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c b/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c
index 30d5e5ddf..e27fd78b8 100644
--- a/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c
+++ b/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c
@@ -619,6 +619,15 @@ static void inno_dsidphy_lvds_mode_enable(struct inno_dsidphy *inno)
 	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x04,
 			REG_FBDIV_LO_MASK, REG_FBDIV_LO(fbdiv));
 	phy_update_bits(inno, REGISTER_PART_LVDS, 0x08, 0xff, 0xfc);
+	/* Power up the common analog LDO and PLL, as MIPI mode does */
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
+			REG_LDOPD_MASK | REG_PLLPD_MASK,
+			REG_LDOPD_POWER_ON | REG_PLLPD_POWER_ON);
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
+			REG_SYNCRST_MASK, REG_SYNCRST_RESET);
+	udelay(1);
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
+			REG_SYNCRST_MASK, REG_SYNCRST_NORMAL);
 	/* Enable PLL and Bandgap */
 	phy_update_bits(inno, REGISTER_PART_LVDS, 0x0b,
 			LVDS_PLL_POWER_MASK | LVDS_BANDGAP_POWER_MASK,
@@ -647,6 +656,10 @@ static void inno_dsidphy_lvds_mode_enable(struct inno_dsidphy *inno)
 			LVDS_LANE_EN_MASK, LVDS_CLK_LANE_EN |
 			LVDS_DATA_LANE0_EN | LVDS_DATA_LANE1_EN |
 			LVDS_DATA_LANE2_EN | LVDS_DATA_LANE3_EN);
+	/* and the common analog lanes behind it, as MIPI mode does */
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x00,
+			LANE_EN_MASK, LANE_EN_CK | LANE_EN_3 | LANE_EN_2 |
+			LANE_EN_1 | LANE_EN_0);
 }
 
 static int inno_dsidphy_power_on(struct phy *phy)
-- 
