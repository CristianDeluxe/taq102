From 0e3d3121de49a4c106259f71dfd624d8fc00e49e Mon Sep 17 00:00:00 2001
From: Cristian Deluxe <info@busirocket.com>
Date: Wed, 9 Sep 2026 02:24:24 +0200
Subject: [PATCH 01/12] drm/rockchip: vop: drive the LVDS output enable on
 RK312x

Upstream enables DRM_MODE_CONNECTOR_LVDS through the RGB output enable,
which is right for RK3288 and PX30 and wrong for RK3126/RK3128: this VOP has
its own LVDS enable and dclk polarity bits, bit 26 and bit 27 of
RK3036_AXI_BUS_CTRL, the register the driver already uses for the rgb, hdmi
and mipi enables. The values are the vendor 4.4 tree's
(rockchip_vop_reg.c:1150).

Add lvds_en and lvds_dclk_pol to struct vop_output, fill them in for RK312x,
and use them when the SoC has them; SoCs without the bits keep the old path,
selected by VOP_HAS_REG.

Signed-off-by: Cristian Deluxe <info@busirocket.com>
---
 drivers/gpu/drm/rockchip/rockchip_drm_vop.c | 11 ++++++++---
 drivers/gpu/drm/rockchip/rockchip_drm_vop.h |  2 ++
 drivers/gpu/drm/rockchip/rockchip_vop_reg.c |  2 ++
 3 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
index 0090d8ff0..d7a792cba 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
@@ -1407,9 +1407,14 @@ static void vop_crtc_atomic_enable(struct drm_crtc *crtc,
 
 	switch (s->output_type) {
 	case DRM_MODE_CONNECTOR_LVDS:
-		VOP_REG_SET(vop, output, rgb_dclk_pol, 1);
-		VOP_REG_SET(vop, output, rgb_pin_pol, pin_pol);
-		VOP_REG_SET(vop, output, rgb_en, 1);
+		if (VOP_HAS_REG(vop, output, lvds_en)) {
+			VOP_REG_SET(vop, output, lvds_dclk_pol, 1);
+			VOP_REG_SET(vop, output, lvds_en, 1);
+		} else {
+			VOP_REG_SET(vop, output, rgb_dclk_pol, 1);
+			VOP_REG_SET(vop, output, rgb_pin_pol, pin_pol);
+			VOP_REG_SET(vop, output, rgb_en, 1);
+		}
 		break;
 	case DRM_MODE_CONNECTOR_eDP:
 		VOP_REG_SET(vop, output, edp_dclk_pol, 1);
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
index f04c9731a..c5330d18a 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
@@ -106,6 +106,8 @@ struct vop_output {
 	struct vop_reg mipi_en;
 	struct vop_reg mipi_dual_channel_en;
 	struct vop_reg rgb_en;
+	struct vop_reg lvds_dclk_pol;
+	struct vop_reg lvds_en;
 };
 
 struct vop_common {
diff --git a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
index 72301e0a3..07f46ecec 100644
--- a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
+++ b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
@@ -233,6 +233,8 @@ static const struct vop_output rk3126_output = {
 	.hdmi_dclk_pol = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 23),
 	.rgb_en = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 24),
 	.rgb_dclk_pol = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 25),
+	.lvds_en = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 26),
+	.lvds_dclk_pol = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 27),
 	.mipi_en = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 28),
 	.mipi_dclk_pol = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 29),
 };
