From a0bdd989a9c9f7b08dbc3f7090b2dab2569e957d Mon Sep 17 00:00:00 2001
From: Cristian Deluxe <info@busirocket.com>
Date: Wed, 9 Sep 2026 02:24:26 +0200
Subject: [PATCH 04/12] ARM: dts: rk3128: add the LVDS transmitter and its VOP
 endpoint

Add the lvds node and a third VOP output endpoint for it, shaped like the
PX30 one. The output port carries #address-cells and #size-cells so a board
can add an endpoint@0 with a reg, which the of_graph walk in
rockchip_lvds_bind() needs to find the panel. Give the D-PHY the two extra
gates the driver takes as optional, the MIPI host pclk and the VIO h2p
bridge clock.

Signed-off-by: Cristian Deluxe <info@busirocket.com>
---
 arch/arm/boot/dts/rockchip/rk3128.dtsi | 39 ++++++++++++++++++++++++--
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/rockchip/rk3128.dtsi b/arch/arm/boot/dts/rockchip/rk3128.dtsi
index c49099954..f481430e1 100644
--- a/arch/arm/boot/dts/rockchip/rk3128.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3128.dtsi
@@ -312,6 +312,40 @@ vop_out_dsi: endpoint@1 {
 				reg = <1>;
 				remote-endpoint = <&dsi_in_vop>;
 			};
+
+			vop_out_lvds: endpoint@2 {
+				reg = <2>;
+				remote-endpoint = <&lvds_in_vop>;
+			};
+		};
+	};
+
+	lvds: lvds {
+		compatible = "rockchip,rk3126-lvds";
+		phys = <&dphy>;
+		phy-names = "dphy";
+		power-domains = <&power RK3128_PD_VIO>;
+		rockchip,grf = <&grf>;
+		rockchip,output = "lvds";
+		status = "disabled";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			lvds_in: port@0 {
+				reg = <0>;
+
+				lvds_in_vop: endpoint {
+					remote-endpoint = <&vop_out_lvds>;
+				};
+			};
+
+			lvds_out: port@1 {
+				reg = <1>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
 		};
 	};
 
@@ -619,8 +653,9 @@ hdmi_out: port@1 {
 	dphy: phy@20038000 {
 		compatible = "rockchip,rk3128-dsi-dphy";
 		reg = <0x20038000 0x4000>;
-		clocks = <&cru SCLK_MIPI_24M>, <&cru PCLK_MIPIPHY>;
-		clock-names = "ref", "pclk";
+		clocks = <&cru SCLK_MIPI_24M>, <&cru PCLK_MIPIPHY>,
+			 <&cru PCLK_MIPI>, <&cru HCLK_VIO_H2P>;
+		clock-names = "ref", "pclk", "pclk_host", "h2p";
 		#phy-cells = <0>;
 		power-domains = <&power RK3128_PD_VIO>;
 		resets = <&cru SRST_MIPIPHY_P>;
-- 
