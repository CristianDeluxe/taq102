# TAQ-102 (Denver, RK3126C) -- kernel config fragment for mainline.
#
# Apply it on top of multi_v7_defconfig, in the tree that owns the build:
#
#     make ARCH=arm CROSS_COMPILE=/work/output/host/bin/arm-buildroot-linux-gnueabihf- \
#          multi_v7_defconfig taq102.config
#
# kbuild's "%.config" target (scripts/kconfig/Makefile) merges any
# arch/arm/configs/<name>.config named after a defconfig and then runs
# olddefconfig, so this file belongs at arch/arm/configs/taq102.config. It can
# equally be fed to scripts/kconfig/merge_config.sh against an existing .config.
#
# Everything below is either missing from multi_v7_defconfig or carried there
# as a module. The root filesystem is a gzip initramfs with no /lib/modules in
# it, so anything this appliance needs has to be built in. Symbols that
# multi_v7_defconfig already gets right are deliberately absent: PARTITION_ADVANCED,
# CMDLINE_PARTITION, EXT4_FS, MMC_DW/MMC_DW_ROCKCHIP, I2C_RK3X, MFD_RK8XX_I2C,
# REGULATOR_RK808, BACKLIGHT_PWM, ROCKCHIP_IOMMU, ROCKCHIP_PM_DOMAINS,
# ROCKCHIP_IODOMAIN, ROCKCHIP_THERMAL, INPUT_EVDEV, RFKILL, IIO, DRM, FB and
# FRAMEBUFFER_CONSOLE are all already y, and CLK_RK312X, ROCKCHIP_VOP,
# PINCTRL_ROCKCHIP, GPIO_ROCKCHIP, PWRSEQ_SIMPLE and DRM_FBDEV_EMULATION are
# already y by their own Kconfig defaults under ARCH_ROCKCHIP.
#
# Board values come from the vendor 4.4.167 build (/work/kernel-v40.config,
# /work/kernel) or from the dmesg recovered off the tablet on 2026-09-03, never
# from a datasheet.
#
# --------------------------------------------------------------------------
# Recommended kernel command line (see the CMDLINE block at the bottom):
#
#   console=tty0 ignore_loglevel consoleblank=0 \
#       blkdevparts=mmcblk1:-@0x94880000(data)
#
# It also needs, in the board DTS:
#
#   aliases { mmc0 = &sdmmc; mmc1 = &emmc; mmc2 = &sdio; };
#
# so the eMMC is mmcblk1, the name the vendor kernel gave it and the one
# br2-external/board/taq102/rootfs-overlay/init globs for.
# --------------------------------------------------------------------------

#
# The console. This board has no reachable UART -- the bootloader's
# earlycon=uart8250,mmio32,0x20068000 goes to pads nobody has found -- so the
# only interactive console is the CDC ACM gadget that /init raises from
# configfs on dwc2 at 10180000.usb. If any line in this block is wrong there is
# no /sys/class/udc and no console at all.
#
# rk3128.dtsi's usb_otg names phys = <&usb2phy_otg>, a port of the
# "rockchip,rk3128-usb2phy" node inside the GRF. That is
# drivers/phy/rockchip/phy-rockchip-inno-usb2.c, NOT the PHY_ROCKCHIP_USB=y
# that multi_v7_defconfig enables; without it dwc2 defers forever. The driver
# "depends on EXTCON" (drivers/phy/rockchip/Kconfig:44), so with EXTCON off the
# line below is dropped in silence -- which is why EXTCON is spelled out.
# The vendor build has exactly this pair: EXTCON=y and
# PHY_ROCKCHIP_INNO_USB2=y (kernel-v40.config:3952, :4201).
#
CONFIG_EXTCON=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
# multi_v7_defconfig has USB_DWC2=y and USB_GADGET=y (so DWC2 lands on
# DUAL_ROLE by default, as the vendor build does) but USB_CONFIGFS=m. Its ACM
# and SERIAL sub-options are already y and follow it in.
CONFIG_USB_CONFIGFS=y
# Not used by the recommended cmdline: /init raises the gadget and runs a getty
# on ttyGS0. It is here because it is the only way to get printk off this board
# if the panel never lights, and the panel is precisely what is unproved on
# mainline -- add console=ttyGS0 to the command line and messages follow the
# ACM. Rebuilding for it later means flashing a kernel with no console to read.
CONFIG_U_SERIAL_CONSOLE=y

#
# /data. Mainline has no equivalent of the vendor's rkpart
# (block/partitions/rk.c), which turned the bootloader's mtdparts= into
# mmcblk1p1..p16, and the eMMC has no GPT, so without a blkdevparts= nothing at
# all appears under /sys/class/block for the data partition.
# CONFIG_CMDLINE_PARTITION and CONFIG_PARTITION_ADVANCED are already y in
# multi_v7_defconfig; only the command line below is missing.
#
# The offset is the one place the arithmetic has to be exact. The bootloader
# passes -@0x004a2400(userdata), in 512-byte sectors, and rkpart adds
# FROM_OFFSET = 0x2000 sectors before calling put_partition
# (block/partitions/rk.h:24, rk.c:330), while printing the offset without it.
# So the dmesg line "userdata: 0x094480000" is 4 MiB short of the real start:
#
#     0x004a2400 + 0x2000 = 4867072 sectors = 0x94880000 bytes
#
# 4867072 is the LBA /init and src/reboot_target.c search for, and it is what
# the running tablet reports. Do not copy 0x94480000 out of the dmesg.
#

#
# Display: VOP -> our rk312x LVDS (patches 0001-0003) -> the Innosilicon
# MIPI/LVDS/TTL D-PHY -> panel-lvds, backlight on pwm0.
#
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_LVDS=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_LVDS=y
CONFIG_PWM_ROCKCHIP=y
# multi_v7_defconfig gets CMA only as a side effect of DRM_ETNAVIV=m selecting
# it, and carries CMA_SIZE_MBYTES=64 on top of that. Trim etnaviv and the
# rockchip framebuffers lose their allocator without a word, so say it outright.
# 24 MiB is the vendor's own number: its board DTS reserves a 0x1800000
# shared-dma-pool at 0x88000000 and the tablet prints "created CMA memory pool
# at 0x88000000, size 24 MiB". 1024x600x4 is 2.4 MB a buffer. If a
# reserved-memory node is ever added to the mainline board DTS, drop these
# three lines rather than having both.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=24

#
# GPU. Mali-400 MP2 -> lima. This is a different UAPI from the vendor /dev/mali:
# the r7p0 Utgard blob the current glcube links against cannot talk to lima, so
# a mainline image needs Mesa's lima gallium driver instead of
# package/mali-utgard. DRM_LIMA selects PM_DEVFREQ and its governor itself.
#
CONFIG_DRM_LIMA=y

#
# Wi-Fi: RTL8723CS on SDIO (mmc2 on the vendor kernel). rtw88 wants
# rtw88/rtw8703b_fw.bin in the initramfs (rtw8703b.c:1890); it is requested
# asynchronously, so a missing file is a silently absent wlan0, not a probe
# error. CFG80211_WEXT is not decoration: /proc/net/wireless, which
# src/status.c reads for quality and level, is wext-proc.c, built only under
# WEXT_PROC <- WEXT_CORE <- CFG80211_WEXT. The vendor build has WEXT_PROC=y.
#
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_RTW88=y
CONFIG_RTW88_8723CS=y

#
# RK816 on i2c2, beside the touch controller. Stock mainline's rk816 cells are
# pinctrl, clkout, regulator, pwrkey and rtc (drivers/mfd/rk8xx-core.c:108) with
# no charger cell, so /sys/class/power_supply/battery would not exist at all.
# Patch 0004-power-supply-rk816-battery adds the charger cell and the driver
# behind it; CONFIG_CHARGER_RK816 below is what actually builds it, and without
# that line the control centre's battery readout and brightness policy have
# nothing to read. rk808-clkout is what feeds the RTL8723CS its 32.768 kHz.
#
CONFIG_PINCTRL_RK805=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_RTC_DRV_RK808=y
CONFIG_COMMON_CLK_RK808=y
# The volume keys are adc-keys on the SARADC in the vendor board DTS
# (rk3126-taq102.dts:2040), and both are y in the vendor config.
CONFIG_KEYBOARD_ADC=y
CONFIG_ROCKCHIP_SARADC=y
# The touch node of patch 0005-input-touchscreen-gsl3673 declares two fixed
# regulators, and multi_v7_defconfig does not enable the driver for them.
CONFIG_REGULATOR_FIXED_VOLTAGE=y

#
# Touch: GSL3673 at i2c2 0x40, driven by mainline silead.c with the compatible
# added in patch 0005-input-touchscreen-gsl3673. It uploads a firmware file
# rather than a built-in array, so /lib/firmware/silead/gsl3673.fw has to be in
# the initramfs.
#
CONFIG_TOUCHSCREEN_SILEAD=y
# The RK816 fuel gauge and charger from patch 0004-power-supply-rk816-battery:
# the driver that registers /sys/class/power_supply/{battery,usb,ac}, the three
# nodes src/status.c reads. It is a cell of MFD_RK8XX_I2C, already y.
CONFIG_CHARGER_RK816=y

#
# SoC base. The CPU is 410fc075, Cortex-A7 r0p5 (dmesg 2026-09-03, line 7);
# ARM_ERRATA_814220 covers A7 r0p2..r0p5 (arch/arm/Kconfig:887), nothing under
# ARCH_ROCKCHIP selects it and multi_v7_defconfig does not set it.
# 1 GB at 0x60000000 needs HIGHMEM to be fully usable; the vendor sets both.
# ARM_ERRATA_754322 in the vendor config is a Cortex-A9 erratum and is not
# carried over.
#
CONFIG_ARM_ERRATA_814220=y
CONFIG_HIGHMEM=y
CONFIG_HIGHPTE=y

#
# The command line. This U-Boot ignores the Android boot image header's cmdline
# field -- tools/make-recovery.sh passes --cmdline buildvariant=user and it has
# never appeared in /proc/cmdline -- and supplies its own through the DT chosen
# node:
#
#   earlycon=uart8250,mmio32,0x20068000 console=ttyFIQ0 androidboot.* \
#   init=/init mtdparts=rk29xxnand:... storagemedia=emmc ...
#
# CONFIG_CMDLINE is therefore the only way to add anything, and it is proved to
# work on this board: the running 4.4 kernel carries
# CONFIG_CMDLINE="console=tty0 ignore_loglevel" with CMDLINE_EXTEND
# (kernel-v40.config:561) and both halves show up in its "Kernel command line:".
# Mainline concatenates the other way round -- drivers/of/fdt.c:1135 appends
# CONFIG_CMDLINE after the bootloader's, where 4.4 put it first -- which only
# helps: our console= is last and wins /dev/console. The bootloader's ttyFIQ0
# names a driver mainline does not have and is ignored either way.
#
# blkdevparts describes exactly one partition, data, at the real userdata start
# derived above. Every other Android partition (boot, recovery, misc) stays
# invisible to the running system, which is what this appliance wants: the
# tools that write them address the raw device by LBA.
#
CONFIG_CMDLINE="console=tty0 ignore_loglevel consoleblank=0 blkdevparts=mmcblk1:-@0x94880000(data)"
CONFIG_CMDLINE_EXTEND=y
