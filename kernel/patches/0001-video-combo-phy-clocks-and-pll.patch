 static void inno_video_phy_lvds_mode_enable(struct inno_video_phy *inno)
 {
+	/*
+	 * The vendor's own dividers, and they are not a guess: measured
+	 * 2026-09-05 against the panel with a fixed camera, 2/28 (336 MHz)
+	 * holds a single-pixel vertical line pattern still to 0.005 px rms,
+	 * where 12/175 (350 MHz) wobbles it by 0.63 to 0.81 px rms -- the
+	 * shimmer I had been reporting for two days. A low prediv is
+	 * the likely reason: it runs the phase detector at 12 MHz instead of
+	 * 2 MHz, and a PLL comparing that rarely is a jittery one.
+	 *
+	 * The earlier reasoning here, that the serial clock must be exactly 7x
+	 * the pixel clock or the panel saturates to white, was one of the
+	 * results taken while LDO6 was off and the panel unpowered; every one
+	 * of those is void. 336 MHz drives this 50 MHz panel correctly.
+	 */
 	u8 prediv = 2;
 	u16 fbdiv = 28;
 	u32 val;
@@ -461,6 +482,15 @@ static void inno_video_phy_lvds_mode_enable(struct inno_video_phy *inno)
 	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x04,
 			REG_FBDIV_LO_MASK, REG_FBDIV_LO(fbdiv));
 	phy_update_bits(inno, REGISTER_PART_LVDS, 0x08, 0xff, 0xfc);
+	/* Power up the common analog LDO and PLL, as MIPI mode does */
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
+			REG_LDOPD_MASK | REG_PLLPD_MASK,
+			REG_LDOPD_POWER_ON | REG_PLLPD_POWER_ON);
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
+			REG_SYNCRST_MASK, REG_SYNCRST_RESET);
+	udelay(1);
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
+			REG_SYNCRST_MASK, REG_SYNCRST_NORMAL);
 	/* Enable PLL and Bandgap */
 	phy_update_bits(inno, REGISTER_PART_LVDS, 0x0b,
 			LVDS_PLL_POWER_MASK | LVDS_BANDGAP_POWER_MASK,
@@ -488,6 +518,10 @@ static void inno_video_phy_lvds_mode_enable(struct inno_video_phy *inno)
 			LVDS_LANE_EN_MASK, LVDS_CLK_LANE_EN |
 			LVDS_DATA_LANE0_EN | LVDS_DATA_LANE1_EN |
 			LVDS_DATA_LANE2_EN | LVDS_DATA_LANE3_EN);
+	/* and the common analog lanes behind it, as MIPI mode does */
+	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x00,
