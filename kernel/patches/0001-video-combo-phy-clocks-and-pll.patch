 	/* Bandgap power on */
@@ -570,8 +612,10 @@ static int inno_video_phy_power_off(struct phy *phy)
 			LVDS_PLL_POWER_OFF | LVDS_BANDGAP_POWER_DOWN);
 
 	pm_runtime_put(inno->dev);
