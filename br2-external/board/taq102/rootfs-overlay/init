#!/bin/sh
#
# TAQ-102 initramfs init.
#
# The tablet has no reachable serial port and this kernel is built without
# CONFIG_VT, so it cannot print to its own panel either. The USB ACM gadget is
# therefore the only console that exists, and raising it is the first thing that
# happens here -- before anything that can fail.

BUILD_ID="taq102-initramfs @@BUILD_ID@@"

/bin/busybox mkdir -p /proc /sys /dev /run /tmp
/bin/busybox mount -t proc     proc     /proc
/bin/busybox mount -t sysfs    sysfs    /sys
/bin/busybox mount -t tmpfs    tmpfs    /run
/bin/busybox mount -t tmpfs    tmpfs    /tmp

# The stock kernel sets CONFIG_DEVTMPFS=y but NOT CONFIG_DEVTMPFS_MOUNT, so
# nothing mounts /dev for us.
/bin/busybox mount -t devtmpfs devtmpfs /dev || /bin/busybox mdev -s

/bin/busybox --install -s /bin >/dev/null 2>&1

echo "$BUILD_ID: init running" > /dev/kmsg

# --- USB ACM gadget: the console -------------------------------------------
mount -t configfs none /sys/kernel/config 2>/dev/null

G=/sys/kernel/config/usb_gadget/taq102
if [ -d /sys/kernel/config/usb_gadget ]; then
    mkdir -p "$G" 2>/dev/null
    cd "$G" || exit 1

    # Linux Foundation / Multifunction Composite Gadget. Generic on purpose:
    # macOS binds its own CDC-ACM driver on class, not on these ids.
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo 0x0100 > bcdDevice
    echo 0x0200 > bcdUSB

    mkdir -p strings/0x409
    echo "TAQ102"                > strings/0x409/manufacturer
    echo "TAQ102 rescue console" > strings/0x409/product
    echo "0000000000000001"      > strings/0x409/serialnumber

    mkdir -p configs/c.1/strings/0x409
    echo "acm" > configs/c.1/strings/0x409/configuration
    echo 250   > configs/c.1/MaxPower

    mkdir -p functions/acm.gs0
    ln -sf functions/acm.gs0 configs/c.1/ 2>/dev/null

    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    if [ -n "$UDC" ]; then
        echo "$UDC" > UDC 2>/dev/null && GADGET_UP=yes
    fi
    cd /
fi

if [ "$GADGET_UP" = yes ]; then
    echo "$BUILD_ID: acm gadget bound to $UDC" > /dev/kmsg
else
    echo "$BUILD_ID: NO gadget -- no console will appear" > /dev/kmsg
fi

# --- from here on there is somewhere to shout ------------------------------
mkdir -p /sys/kernel/debug && mount -t debugfs none /sys/kernel/debug 2>/dev/null

# Our own kernel carries the LVDS PHY driver as a module (built in, it hangs
# the boot before there is a console). Nothing draws until it is loaded, so it
# goes in here, now that there is somewhere to report a failure.
[ -x /usr/sbin/taq102-display ] && /usr/sbin/taq102-display

# The USB PHY's BC1.2 detection reports nothing on this board -- every extcon
# cable reads zero with the cable in and the gadget enumerated -- so the kernel
# holds the RK816's input to the 450 mA an unclassified port is worth. At full
# brightness the panel and the SoC together draw more than that, and the tablet
# discharges while reporting Charging (measured 2026-09-10: -259 mA with the
# cube running). The kernel is right to be careful and this is where the board
# knows better, so raise it from here. The override lasts until the cable is
# pulled, and 1.6 A is what the board's own device tree declares.
for ICL in /sys/class/power_supply/usb/input_current_limit; do
    [ -w "$ICL" ] && echo 1600000 > "$ICL" 2>/dev/null &&
        echo "$BUILD_ID: input current limit raised to $(cat "$ICL")" > /dev/kmsg
done

# The panel's backlight comes up at the device tree's default of 128 of 255,
# which reads as a washed-out screen and is not a colour problem. Nothing else
# raises it, so do it here, before anything draws. The rescue image runs the
# stock kernel, whose rk816 driver throws the USB detection's 1500 mA away
# for the DC path's 450 mA (measured again 2026-09-07: the rescue drained at
# 292 mA on a CDP port at full brightness); at 40 of 255 the same port
# charges, so the rescue keeps its light low.
BL_LEVEL=max
[ "$(cat /etc/taq102-variant 2>/dev/null)" = rescue ] && BL_LEVEL=40
for BL in /sys/class/backlight/*/brightness; do
    [ -w "$BL" ] || continue
    MAX=$(cat "$(dirname "$BL")/max_brightness" 2>/dev/null) || continue
    LEVEL=$MAX; [ "$BL_LEVEL" = max ] || LEVEL=$BL_LEVEL
    echo "$LEVEL" > "$BL" 2>/dev/null && echo "$BUILD_ID: backlight $LEVEL of $MAX" > /dev/kmsg
done

# A crash log left by a previous kernel, rescued before anything can allocate
# over it. The mainline diagnostic images put a ramoops region at 0x68100000,
# which is ordinary RAM to this kernel -- on 2026-09-08 the first captured log
# was already overwritten by modetest and libevdev by the time it was read over
# ssh, three minutes into the boot. Copying it here, before /data is even
# mounted, is the only way to win that race. 960 KB, and it costs nothing when
# there is nothing there: the signature check discards a region full of
# whatever the last boot left.
if [ -c /dev/mem ] || mknod /dev/mem c 1 1 2>/dev/null; then
    dd if=/dev/mem of=/tmp/ramoops-prev.bin bs=4096 skip=426240 count=240 2>/dev/null
    if head -c 4 /tmp/ramoops-prev.bin 2>/dev/null | grep -q DBGC; then
        echo "$BUILD_ID: rescued a previous kernel's ramoops from 0x68100000" > /dev/kmsg
    else
        rm -f /tmp/ramoops-prev.bin
    fi
fi

# Persistent storage. Everything above this line lives in RAM and dies at
# reboot; the last partition -- Android's `userdata`, 55 GB -- is where anything
# that has to survive goes. Mount it only if it already carries a filesystem:
# creating one is a deliberate act with mkfs.ext4, never something a boot does.
# Never by partition number. They are not stable: the same kernel and the same
# system listed 17 partitions starting at LBA 8192 on one boot and 16 starting
# at 16384 on the next, so userdata was p17 once and p16 the next time. The
# start sector is what does not move.
DATA=
for P in /sys/class/block/mmcblk1p*; do
    [ "$(cat "$P/start" 2>/dev/null)" = 4867072 ] || continue
    DATA=/dev/$(basename "$P")
    break
done

if [ -n "$DATA" ] && [ -b "$DATA" ]; then
    mkdir -p /data
    if mount -t ext4 -o noatime "$DATA" /data 2>/dev/null; then
        echo "$BUILD_ID: /data mounted from $DATA" > /dev/kmsg
    else
        echo "$BUILD_ID: $DATA carries no ext4; /data left empty" > /dev/kmsg
    fi
else
    echo "$BUILD_ID: no partition at LBA 4867072; /data left empty" > /dev/kmsg
fi

# Now that /data exists, park the rescued crash log where it survives a reboot.
if [ -s /tmp/ramoops-prev.bin ] && [ -d /data/. ]; then
    cp /tmp/ramoops-prev.bin "/data/ramoops-$(date +%Y%m%d-%H%M%S).bin" 2>/dev/null &&
        echo "$BUILD_ID: previous ramoops saved under /data" > /dev/kmsg
fi

# BusyBox init never runs rcS here, so nothing else sets the hostname; mdnsd
# announces it as taq102.local and udhcpc sends it to the router.
hostname "$(cat /etc/hostname 2>/dev/null || echo taq102)"

cat > /etc/inittab <<EOF
::sysinit:/bin/mount -a
::once:/usr/sbin/taq102-wifi up
::once:/usr/sbin/taq102-ssh
::once:/usr/bin/taq102-app
ttyGS0::respawn:/sbin/getty -L ttyGS0 115200 vt100
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
EOF

echo "$BUILD_ID: handing over to init" > /dev/kmsg
exec /sbin/init
