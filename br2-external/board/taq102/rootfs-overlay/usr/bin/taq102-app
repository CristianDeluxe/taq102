#!/bin/sh
#
# Start the KMS application and keep it running.
#
# Two ways out, because an appliance that always grabs the screen and restarts
# forever is a device you cannot debug:
#   * /etc/taq102-no-autostart -- what the rescue image carries.
#   * holding the one button down while it boots. This tablet has exactly two
#     buttons -- power, and one other -- while the device tree declares two ADC
#     keys, "Volume Up" at 0 V reporting KEY_BACK (158) and "Volume Down" at
#     1.65 V reporting KEY_VOLUMEDOWN (114). One of those two does not exist in
#     the plastic, and which code the real one sends has not been measured, so
#     accept either.
#
# The restart limit matters: a crash loop against a KMS surface would otherwise
# spend the whole uptime taking and dropping DRM master.

APP=${TAQ102_APP:-/usr/bin/glcube}
LIMIT=5

log() { echo "taq102-app: $1" > /dev/kmsg; }

# A rescue boot must look like one. Under the stock kernel nothing sets a
# mode until an application does, so a rescue that draws nothing is a white
# panel -- indistinguishable from an appliance that failed. rescue-screen
# paints RESCUE MODE, the kernel, the build id and the address instead.
rescue() {
    log "$1"
    if [ -x /usr/bin/rescue-screen ]; then
        [ -e /dev/dri/card0 ] || sleep 3
        exec /usr/bin/rescue-screen >> /tmp/taq102-app.log 2>&1
    fi
    exit 0
}

if [ -f /etc/taq102-no-autostart ]; then
    rescue "autostart disabled by /etc/taq102-no-autostart"
fi

for KEY in KEY_VOLUMEDOWN KEY_BACK; do
    evtest --query /dev/input/event2 EV_KEY "$KEY"
    if [ $? -eq 10 ]; then
        rescue "$KEY held at boot: not starting $APP"
    fi
done

# The DRM device appears asynchronously: the deferred-probe workqueue finishes
# binding rockchip-drm after `insmod` of the PHY module has already returned,
# and on the first appliance boot glcube ran 0.27 s before /dev/dri/card0
# existed, spending one of its attempts on "Open card0: No such file".
i=0
while [ ! -e /dev/dri/card0 ] && [ $i -lt 100 ]; do
    usleep 100000
    i=$((i + 1))
done
[ -e /dev/dri/card0 ] || log "no /dev/dri/card0 after 10 s; starting $APP anyway"

n=0
while [ $n -lt $LIMIT ]; do
    log "starting $APP (attempt $((n + 1)))"
    "$APP" >> /tmp/taq102-app.log 2>&1
    n=$((n + 1))
    sleep 1
done

log "$APP exited $LIMIT times; giving up"
