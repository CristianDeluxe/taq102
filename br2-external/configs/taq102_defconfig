# Denver TAQ-102 — Rockchip RK3126C, ARMv7 Cortex-A7, 1 GB RAM.
# Userspace only: this image runs under the stock vendor kernel 4.4.103, which
# is why nothing here builds or configures a kernel.

BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON_VFPV4=y

# musl for a small 32-bit userspace with 64-bit time_t.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# Headers matched to the kernel this actually runs on. Buildroot's menu offers
# nothing older than 5.10; 4.4.302 is the last 4.4 stable release.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.4.302"
# The series must be declared too, or the strict header check refuses the build
# with "expected 2.6.x, got 4.4.x".
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_4=y

# 4.4 predates C23; its unifdef host tool uses `constexpr` as a variable name
# and GCC 15 refuses it. One rename patch, applied to linux-headers.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_TAQ102_PATH)/patches"

BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="taq102"
BR2_TARGET_GENERIC_ISSUE="TAQ-102 rescue image"
BR2_INIT_BUSYBOX=y

# Our own /init lives here; it raises the USB ACM gadget before anything else.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TAQ102_PATH)/board/taq102/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_TAQ102_PATH)/board/taq102/post-build.sh"

# gzip is the only initramfs compression this kernel can decompress:
# CONFIG_RD_GZIP=y, and RD_LZO / RD_LZ4 / RD_XZ are all unset.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set

# For the KMS and touch bring-up in Gate 4.
BR2_PACKAGE_LIBDRM=y
# modetest, to prove the panel with a real modeset. The stock kernel keeps
# scanning out U-Boot's logo buffer (rockchip,drm-logo reserved region) until
# something does drmModeSetCrtc, so writing to /dev/fb0 changes nothing.
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_EVTEST=y
