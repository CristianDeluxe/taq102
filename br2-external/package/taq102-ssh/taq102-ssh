#!/bin/sh
#
# Start dropbear with everything that must outlive a reflash kept on /data:
#
#   /data/ssh/host_rsa, /data/ssh/host_ed25519   this machine's identity
#   /data/ssh/authorized_keys                    who may log in
#
# Host keys in /etc would be regenerated on every boot, since the root
# filesystem is an initramfs -- every login would then be a changed-host-key
# warning, and the warning would be right.
#
# Password authentication is disabled. Root has no password on this image, and
# a blank or guessable one on a device sitting on the LAN is worse than
# requiring a key.
set -eu

DIR=/data/ssh

[ -d /data/. ] || { echo "taq102-ssh: no /data; not starting" > /dev/kmsg; exit 0; }

mkdir -p "$DIR"
chmod 700 "$DIR"

[ -f "$DIR/host_rsa" ]     || dropbearkey -t rsa -s 2048 -f "$DIR/host_rsa" >/dev/null 2>&1
[ -f "$DIR/host_ed25519" ] || dropbearkey -t ed25519 -f "$DIR/host_ed25519" >/dev/null 2>&1

# Root's home is on tmpfs; point its .ssh at the persistent copy.
mkdir -p /root/.ssh
chmod 700 /root/.ssh
if [ -f "$DIR/authorized_keys" ]; then
    cp "$DIR/authorized_keys" /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
else
    echo "taq102-ssh: no $DIR/authorized_keys -- nobody can log in" > /dev/kmsg
fi

dropbear -s -g -R -r "$DIR/host_rsa" -r "$DIR/host_ed25519" -p 22
echo "taq102-ssh: dropbear listening on 22" > /dev/kmsg
