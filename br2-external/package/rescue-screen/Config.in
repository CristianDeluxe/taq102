config BR2_PACKAGE_RESCUE_SCREEN
	bool "rescue-screen (the rescue image's amber status screen)"
	select BR2_PACKAGE_LIBDRM
	help
	  Draws RESCUE MODE, the kernel, the build id and the Wi-Fi address on
	  the panel through a DRM dumb buffer, so a rescue boot cannot be
	  mistaken for an appliance that failed to draw. taq102-app starts it
	  whenever autostart is off.
