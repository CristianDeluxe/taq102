#!/bin/sh
#
# Bring up the RTL8723CS. The module is the vendor's own, loaded under the
# vendor's own kernel, so the vermagic and the CONFIG_MODVERSIONS symbol CRCs
# match by construction -- which is the entire reason this image runs the stock
# kernel.
#
# Configuration lives on /data, because that is the only thing here that
# survives a reboot:
#
#   /data/wifi.conf   a wpa_supplicant configuration (wpa_passphrase writes one)
#   /data/wifi.mac    the MAC address to keep using
#
# The MAC matters more than it looks. This board has no MAC in vendor storage --
# rk_vendor_read fails and the driver says so, then assigns a random one -- so
# without pinning it the tablet arrives as a different device on every boot and
# collects a new DHCP lease each time.
#
# Usage: taq102-wifi [up|down|scan|status]

MODULE=/lib/modules/$(uname -r)/extra/8723cs.ko
CONF=/data/wifi.conf
MACFILE=/data/wifi.mac
IFACE=wlan0

load() {
    if [ -d /sys/class/net/$IFACE ]; then
        return 0
    fi
    # The BSP powers the chip through its own rfkill node before the SDIO
    # function can be probed at all.
    for RK in /sys/class/rkwifi/power /sys/class/rfkill/rfkill*/state; do
        [ -w "$RK" ] && echo 1 > "$RK" 2>/dev/null
    done
    # The vendor driver loses a race with its own power-up sequence now and
    # then -- measured on 2026-09-02: `sdio_deinit: sdio_disable_func(-5)` at
    # 4.4 s and the driver unbinding itself, on a boot no different from the
    # ones that work. One retry through the BSP's power and card-detect nodes
    # is worth trying; it is not known to recover a chip that has already
    # failed, and nothing short of removing power is.
    attempt=0
    while [ $attempt -lt 2 ]; do
        if [ $attempt -gt 0 ]; then
            rmmod 8723cs 2>/dev/null
            echo 0 > /sys/class/rkwifi/driver 2>/dev/null
            echo 0 > /sys/class/rkwifi/power 2>/dev/null
            sleep 2
            echo 1 > /sys/class/rkwifi/power 2>/dev/null
            echo 1 > /sys/class/rkwifi/driver 2>/dev/null
            sleep 1
        fi
        insmod "$MODULE" 2>/dev/null

        i=0
        while [ ! -d /sys/class/net/$IFACE ] && [ $i -lt 40 ]; do
            sleep 0.2
            i=$((i + 1))
        done
        [ -d /sys/class/net/$IFACE ] && break
        attempt=$((attempt + 1))
    done

    if [ ! -d /sys/class/net/$IFACE ]; then
        # Say the useful thing rather than just failing: reloading the module
        # again will not fix this, and a warm reboot does not either, because
        # neither takes power off the RTL8723CS.
        echo "taq102-wifi: no $IFACE. The chip needs power removed -- a full" \
             "power-off, not a reboot." > /dev/kmsg
        return 1
    fi

    if [ -s "$MACFILE" ]; then
        ip link set $IFACE address "$(cat "$MACFILE")" 2>/dev/null &&
            echo "taq102-wifi: MAC $(cat "$MACFILE") from $MACFILE" > /dev/kmsg
    elif [ -d /data/. ]; then
        cat /sys/class/net/$IFACE/address > "$MACFILE" 2>/dev/null &&
            echo "taq102-wifi: kept this boot's random MAC in $MACFILE" > /dev/kmsg
    fi
    return 0
}

case "${1:-up}" in
up)
    # `up` has to be safe to run when it has already run. The panel can ask for
    # it on a boot whose own `taq102-wifi up` already succeeded, and starting a
    # second wpa_supplicant on one interface is not harmless: the two reset
    # each other's association forever. Measured on the tablet 2026-09-07 --
    # two wpa_supplicant, two udhcpc and two mdnsd, wlan0 UP with NO-CARRIER
    # and `rtw_set_802_11_connect` repeating for the best part of two hours.
    # Killing the later set alone did not recover it; one clean supplicant
    # associated at -32 dBm in fifteen seconds.
    if ip link show $IFACE 2>/dev/null | grep -q LOWER_UP &&
       ip -4 addr show $IFACE 2>/dev/null | grep -q inet; then
        echo "$IFACE is already associated and addressed; nothing to do" >&2
        exit 0
    fi
    # Anything left over from a previous attempt goes before a new one starts.
    killall mdnsd udhcpc wpa_supplicant 2>/dev/null
    load || { echo "8723cs did not give us $IFACE" >&2; exit 1; }
    ip link set $IFACE up
    if [ ! -f "$CONF" ]; then
        echo "$IFACE is up; write $CONF to associate" >&2
        echo "  wpa_passphrase <ssid> <psk> > $CONF" >&2
        exit 0
    fi
    # -O supplies the control interface the conf lacks: `wpa_passphrase` does
    # not write a `ctrl_interface=` line, so without this `taq102-wifi status`
    # and `scan` fail with "No such file or directory" and there is no way to
    # ask the daemon anything.
    wpa_supplicant -B -i $IFACE -c "$CONF" -O /var/run/wpa_supplicant -D nl80211 2>/dev/null ||
        wpa_supplicant -B -i $IFACE -c "$CONF" -O /var/run/wpa_supplicant -D wext ||
        { echo "wpa_supplicant refused both nl80211 and wext" >&2; exit 1; }
    # Option 12 with the hostname, so a router that resolves its leases
    # answers to `taq102`; mDNS answers to `taq102.local` once the address
    # is there (mdnsd binds the interface it is given and daemonises).
    udhcpc -i $IFACE -b -x hostname:"$(hostname)"
    i=0
    while [ $i -lt 30 ] && ! ip -4 addr show $IFACE | grep -q inet; do sleep 1; i=$((i + 1)); done
    if command -v mdnsd >/dev/null; then
        mdnsd -i $IFACE && echo "taq102-wifi: mdnsd announcing $(hostname).local on $IFACE" > /dev/kmsg
    fi
    ;;
down)
    killall mdnsd udhcpc wpa_supplicant 2>/dev/null
    ip link set $IFACE down 2>/dev/null
    rmmod 8723cs 2>/dev/null
    ;;
scan)
    load || exit 1
    ip link set $IFACE up
    iw dev $IFACE scan 2>/dev/null | grep -E "SSID|signal" ||
        wpa_cli -i $IFACE scan_results
    ;;
status)
    ip addr show $IFACE 2>/dev/null || echo "$IFACE not present"
    wpa_cli -i $IFACE status 2>/dev/null
    ;;
*)
    echo "usage: taq102-wifi [up|down|scan|status]" >&2
    exit 1
    ;;
esac
